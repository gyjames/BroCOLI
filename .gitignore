/_deps/

# Compiled objects and libraries
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.gcda
*.gcno
*.gcov

# Local datasets and run outputs; keep small fixtures under tests/ or example/
/data/
/results/
/output/
/demux/
/demux_xyz/
