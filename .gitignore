/example/example_SIRV.sam

# Runtime logs and temporary files
*.log
nohup.out
*.tmp
*.swp
*.swo
*~

# Python caches (for helper / test scripts)
__pycache__/
*.pyc
/.venv/

# Local IDE settings and OS metadata
/.vscode/
/.idea/
.DS_Store
Thumbs.db
